# Copy to `.env`. Values already set in the shell always win.

# ---------------- mock vs real ----------------
MOCK_MODE=true
MOCK_SCENARIO=happy_path

# ---------------- OpenRouter (Architect / Developer / Critic) ----------------
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution headers; they get your app listed on OpenRouter's
# leaderboards and are used for abuse triage.
OPENROUTER_REFERER=https://github.com/rzhub/GateMem
OPENROUTER_TITLE=GateMem Self-Improving Orchestrator

# ---------------- local vLLM cluster (Medical Evaluator) ----------------
# Must match the server's --served-model-name exactly.
EVALUATOR_MODEL=qwen3.8-27b
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=sk-local-dummy-key
VLLM_MAX_CONCURRENCY=12

# ---------------- OpenAI (Judge) ----------------
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
JUDGE_MODEL=gpt-4.1

# ---------------- models ----------------
ARCHITECT_MODEL=deepseek/deepseek-v4-flash-0731
DEVELOPER_MODEL=deepseek/deepseek-v4-flash-0731
CRITIC_MODEL=deepseek/deepseek-v4-flash-0731

# ---------------- reasoning budget ----------------
# The DeepSeek models above are REASONING models, and OpenRouter bills their
# reasoning tokens against max_tokens. Uncapped, the Architect spends its whole
# 12288-token allowance thinking and returns finish_reason=length with NO
# content -- the node reports "empty response" and the run halts at MGS=0.
# Capping the effort makes the model commit to an answer. Set to the empty
# string to restore the provider's own default.
OPENROUTER_REASONING_EFFORT=low
# Which models the cap applies to. The Judge shares this route with a
# non-reasoning model (openai/gpt-4.1), which must not receive the block.
OPENROUTER_REASONING_MODEL_PREFIXES=deepseek/

# ---------------- per-node completion budgets ----------------
# Blank / "none" / "0" = UNCAPPED: `max_tokens` is omitted from the request and
# the node generates until it emits a stop token or fills its context window.
# Uncapped is the shipped default for all five nodes -- nothing truncates a
# design document or an action block at an arbitrary ceiling.
#
# What still bounds a call: the per-call wall-clock timeouts, the run-level
# MAX_TOTAL_TOKENS / MAX_WALLCLOCK_S guards, and the context window. Note that
# OPENROUTER_REASONING_EFFORT above matters MORE with the ceiling gone, not
# less: on a reasoning model the thinking channel shares this budget, so an
# uncapped call lets an uncapped reasoner think until the context fills.
#
# Set a positive integer to put one node's ceiling back. Previous values:
# architect 12288, developer 16384, evaluator 2048, judge 2048, critic 8192.
ARCHITECT_MAX_TOKENS=
DEVELOPER_MAX_TOKENS=
EVALUATOR_MAX_TOKENS=
JUDGE_MAX_TOKENS=
CRITIC_MAX_TOKENS=

# ---------------- GateMem data ----------------
GATEMEM_REPO=/home/thaddus/GateMem

# ---------------- thresholds ----------------
DEV_GATE_MGS=0.80
MGS_TARGET=0.85
MAX_ITERATIONS=10
MAX_DEV_RETRIES=5

# How much of the implementation is inlined into the Architect's task text.
# Sized to fit the whole of templates/ (~47k chars): the Architect must see the
# baseline the Developer is gated on -- INCLUDING its tests, which are the
# contract. At 24000 the view truncated and the Architect designed a different
# API than the tests enforce, which cost a whole iteration. ~1% of the model's
# 1.31M-token context, and the highest-leverage context in the run.
ARCHITECT_CODE_VIEW_MAX_CHARS=60000
# How much of the previous iteration's developer build failure the Architect sees.
ARCHITECT_DEV_FAILURE_MAX_CHARS=12000

# ---------------- transports ----------------
# dsh (default, per the brief) or http (direct chat completions for the
# high-fan-out Evaluator/Judge).
AGENT_TRANSPORT=dsh
# Per-node override for the Developer; empty inherits AGENT_TRANSPORT.
# Defaults to http because DEVELOPER_MODEL degenerates into a repetition loop on
# this prompt roughly half the time. That is the model, not the transport -- but
# on dsh a bad sample burns DSH_DEVELOPER_THINK_TIMEOUT_S (300s) before it can be
# retried, while on http it stops at max_tokens in tens of seconds, which is what
# makes DEV_THINK_RESAMPLES a workable mitigation. Set to dsh for strict brief
# compliance, at the cost of a Developer that usually produces nothing.
DEVELOPER_TRANSPORT=http
# Extra samples drawn when the Developer's reply has no parseable action.
# These do NOT consume MAX_DEV_RETRIES -- a decoder stutter is not a statement
# about whether the design can be built.
DEV_THINK_RESAMPLES=3
EVAL_TRANSPORT=dsh
JUDGE_TRANSPORT=dsh

# ---------------- optional web search for the Architect ----------------
SEARCH_API_KEY=
SEARCH_API_URL=https://api.tavily.com/search

# --- dsh harness timeouts -------------------------------------------------
# Per-attempt budgets, in seconds. The Architect gets its own because it is a
# single open-ended design turn over a large context; turns of 400-950s are
# normal for it, while the other nodes are tight tool loops.
# DSH_DEFAULT_TIMEOUT_S=600
# DSH_ARCHITECT_TIMEOUT_S=1800
# The Developer's harness builds autonomously (bash + write surface + subagents)
# and the runtime enforces no turn cap, so this timeout is its ONLY bound.
# DSH_DEVELOPER_TIMEOUT_S=2700
# Retries cover flaky transport, not slow work -- raising this will not help a
# node that is simply slower than its budget. Fix the budget instead.
# DSH_MAX_RETRIES=1
# How long to wait for a timed-out worker to unwind after its harness is closed.
# DSH_TEARDOWN_GRACE_S=60
